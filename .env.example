# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file. NEVER hard-code credentials in source.

# --- Environment ---
JLMACRO_ENV=development

# --- Database (PostgreSQL / TimescaleDB) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jlmacro
POSTGRES_USER=jlmacro
POSTGRES_PASSWORD=change_me_dev_password

# Full SQLAlchemy URL is derived from the above by default; override if needed.
# JLMACRO_DATABASE_URL=postgresql+psycopg://jlmacro:change_me_dev_password@db:5432/jlmacro

# --- API ---
JLMACRO_API_HOST=0.0.0.0
JLMACRO_API_PORT=8000

# --- Dashboard ---
JLMACRO_DASHBOARD_PORT=8501
JLMACRO_API_BASE_URL=http://api:8000

# --- Config files ---
JLMACRO_CONFIG_DIR=config

# --- Logging ---
JLMACRO_LOG_LEVEL=INFO
JLMACRO_LOG_FORMAT=json

# --- Execution safety (never enabled by default) ---
JLMACRO_LIVE_TRADING_ENABLED=false

# --- API authentication (Phase 12) ---
# Unset (the default) leaves the API open - fine for local development against a
# database only reachable from localhost, never for a deployment reachable from
# anywhere else. Set this before exposing the API beyond localhost; every request
# then needs a matching X-API-Key header (see src/jlmacro/api/security.py).
# JLMACRO_API_KEY=

# --- Future broker credentials (placeholders only, never real secrets here) ---
# IBKR_ACCOUNT_ID=
# IBKR_API_KEY=

# --- Real macro data providers (Phase 2) ---
# FRED requires a free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# RBA and ABS do not require an API key.
# FRED_API_KEY=
JLMACRO_HTTP_TIMEOUT_SECONDS=30
